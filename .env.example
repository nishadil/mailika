APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_KEY=base64:replace-with-output-from-php-bin-mailika-key
MAILIKA_TRUSTED_PROXIES=

SESSION_NAME=mailika_session
SESSION_LIFETIME_SECONDS=1800
SESSION_SECURE_COOKIE=false
SESSION_DRIVER=file

DB_DSN=pgsql:host=postgres;port=5432;dbname=mailika
DB_USER=mailika
DB_PASSWORD=change-me
MAILIKA_DATA_STORE=auto

MAILIKA_ALLOWED_IMAP_HOSTS=*
MAILIKA_ALLOWED_SMTP_HOSTS=*
MAILIKA_IMAP_ADAPTER=webklex
MAILIKA_DEFAULT_IMAP_HOST=imap.example.com
MAILIKA_DEFAULT_IMAP_PORT=993
MAILIKA_DEFAULT_IMAP_TLS=true
MAILIKA_DEFAULT_SMTP_HOST=smtp.example.com
MAILIKA_DEFAULT_SMTP_PORT=587
MAILIKA_DEFAULT_SMTP_TLS=starttls
MAILIKA_IMAP_VALIDATE_LOGIN=true

MAILIKA_MAX_ATTACHMENT_BYTES=26214400
MAILIKA_MAX_ATTACHMENTS=10
MAILIKA_MAX_ATTACHMENT_TOTAL_BYTES=52428800
MAILIKA_REMOTE_IMAGES=false
MAILIKA_REQUIRE_TLS=true

MAILIKA_LDAP_ENABLED=false
MAILIKA_LDAP_HOST=ldap.example.com
MAILIKA_LDAP_PORT=389
MAILIKA_LDAP_TLS=starttls
MAILIKA_LDAP_REQUIRE_TLS=true
MAILIKA_ALLOWED_LDAP_HOSTS=*
MAILIKA_LDAP_BASE_DN=ou=people,dc=example,dc=com
MAILIKA_LDAP_BIND_DN=
MAILIKA_LDAP_BIND_PASSWORD=
MAILIKA_LDAP_TIMEOUT_SECONDS=5
MAILIKA_LDAP_MAX_RESULTS=25

MAILIKA_SIEVE_ENABLED=false
MAILIKA_SIEVE_HOST=sieve.example.com
MAILIKA_SIEVE_PORT=4190
MAILIKA_SIEVE_TLS=starttls
MAILIKA_SIEVE_REQUIRE_TLS=true
MAILIKA_ALLOWED_SIEVE_HOSTS=*
MAILIKA_SIEVE_SCRIPT_NAME=mailika
MAILIKA_SIEVE_TIMEOUT_SECONDS=10

MAILIKA_RATE_LIMIT_LOGIN_ATTEMPTS=8
MAILIKA_RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
MAILIKA_RATE_LIMIT_STORE=file
REDIS_DSN=redis://redis:6379/0
REDIS_SESSION_DSN=tcp://redis:6379?database=0

LOG_CHANNEL=file
LOG_PATH=storage/logs/mailika.log
