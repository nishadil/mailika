#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
chdir($root);

$files = [];
exec('git ls-files --cached --others --exclude-standard', $files, $code);
if ($code !== 0) {
    fwrite(STDERR, "Unable to list repository files for secret scan.\n");
    exit(1);
}

$patterns = [
    'private-key-block' => '/-----BEGIN (?:RSA |DSA |EC |OPENSSH )?PRIVATE KEY-----|-----BEGIN PGP PRIVATE KEY BLOCK-----/',
    'aws-access-key' => '/\b(?:AKIA|ASIA)[A-Z0-9]{16}\b/',
    'github-token' => '/\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{36,}\b|\bgithub_pat_[A-Za-z0-9_]{80,}\b/',
    'slack-token' => '/\bxox[baprs]-[A-Za-z0-9-]{20,}\b/',
    'openai-key' => '/\bsk-(?:proj-)?[A-Za-z0-9_-]{32,}\b/',
    'google-api-key' => '/\bAIza[0-9A-Za-z\-_]{35}\b/',
    'stripe-live-secret' => '/\bsk_live_[0-9A-Za-z]{24,}\b/',
];

$allowedMarkers = [
    'src/Crypto/OpenPgpLeakGuard.php' => ['-----BEGIN PGP PRIVATE KEY BLOCK-----'],
    'tests/Unit/ComposeControllerTest.php' => ['-----BEGIN PGP PRIVATE KEY BLOCK-----'],
    'tests/Unit/OpenPgpLeakGuardTest.php' => ['-----BEGIN PGP PRIVATE KEY BLOCK-----'],
];

$skipFiles = [
    'bin/check-secrets' => true,
];

$findings = [];
foreach ($files as $file) {
    $file = trim($file);
    if ($file === '' || isset($skipFiles[$file]) || !is_file($file)) {
        continue;
    }

    $content = file_get_contents($file);
    if (!is_string($content) || str_contains($content, "\0")) {
        continue;
    }

    $lines = preg_split('/\R/', $content) ?: [];
    foreach ($lines as $lineNumber => $line) {
        foreach ($patterns as $name => $pattern) {
            if (preg_match($pattern, $line) !== 1 || allowedFinding($file, $line, $allowedMarkers)) {
                continue;
            }

            $findings[] = sprintf('%s:%d matched %s', $file, $lineNumber + 1, $name);
        }
    }
}

if ($findings !== []) {
    fwrite(STDERR, "Potential secrets were found:\n");
    foreach ($findings as $finding) {
        fwrite(STDERR, " - {$finding}\n");
    }

    exit(1);
}

echo "Secret scan passed.\n";

/**
 * @param array<string, list<string>> $allowedMarkers
 */
function allowedFinding(string $file, string $line, array $allowedMarkers): bool
{
    foreach ($allowedMarkers[$file] ?? [] as $marker) {
        if (str_contains($line, $marker)) {
            return true;
        }
    }

    return false;
}
